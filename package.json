{
  "name": "folio-markdown-viewer",
  "version": "1.0.0",
  "private": true,
  "description": "A quiet place for your Markdown files",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist": "npm run build && electron-builder",
    "test:electron": "npm run build && node tests/electron-smoke.cjs"
  },
  "build": {
    "appId": "com.folio.markdown",
    "productName": "Folio",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "fileAssociations": [
        {
          "ext": [
            "md",
            "markdown"
          ],
          "name": "Markdown document",
          "role": "Viewer",
          "rank": "Alternate"
        }
      ],
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "katex": "^0.16.47",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  },
  "type": "module"
}
